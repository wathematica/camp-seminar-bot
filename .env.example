# Optional settings. Copy to .env if you want to override the defaults.
# Credentials belong in secrets/, created by python3 configure.py.
FIRST_CHOICE_THRESHOLD=3
# Optional: application/Bot ID used to check that the token is for the expected bot.
EXPECTED_BOT_ID=
